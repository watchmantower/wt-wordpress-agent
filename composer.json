{
  "name": "watchmantower/wt-wordpress-agent",
  "description": "Watchman Tower WordPress plugin (dev tooling only; the plugin itself has no Composer dependencies)",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6"
  },
  "autoload-dev": {
    "psr-4": { "WTHB\\": "plugin/" }
  },
  "config": {
    "platform": { "php": "7.4" },
    "sort-packages": true
  },
  "scripts": {
    "lint": "find plugin -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit"
  }
}
